// TheDevDose — users, progress, and analytics (M3+). Course content stays in the
// committed content/ JSON (rendered server-side); the DB holds only per-user
// state. topicId / phaseId are the stable string ids from the content pipeline
// (e.g. "p1a-001", "p1a-javascript").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhaseStatus {
  locked
  unlocked
  completed
}

enum TopicStatus {
  not_started
  in_progress
  completed
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  hinglishPref  Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  xp            Int      @default(0)
  createdAt     DateTime @default(now())

  accounts       Account[]
  sessions       Session[]
  phaseProgress  PhaseProgress[]
  topicProgress  TopicProgress[]
  codeRuns       CodeRun[]
  quizScores     QuizScore[]
  dailyActivity  DailyActivity[]
  streak         Streak?
  achievements   Achievement[]
  events         Event[]
  reviews        Review[]
  savedCode      SavedCode[]
}

// --- NextAuth standard tables (used when OAuth is added later) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Progress & sequential unlocking ---
model PhaseProgress {
  id          String      @id @default(cuid())
  userId      String
  phaseId     String
  status      PhaseStatus @default(locked)
  unlockedAt  DateTime?
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phaseId])
  @@index([userId])
}

model TopicProgress {
  id            String      @id @default(cuid())
  userId        String
  topicId       String
  phaseId       String
  status        TopicStatus @default(not_started)
  viewCount     Int         @default(0)
  firstViewedAt DateTime?
  completedAt   DateTime?
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, phaseId])
}

model CodeRun {
  id         String   @id @default(cuid())
  userId     String
  topicId    String
  language   String
  passed     Boolean
  durationMs Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
}

model QuizScore {
  id      String   @id @default(cuid())
  userId  String
  topicId String
  score   Int
  total   Int
  takenAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyActivity {
  id              String   @id @default(cuid())
  userId          String
  day             DateTime @db.Date
  topicsCompleted Int      @default(0)
  runsCount       Int      @default(0)
  minutesActive   Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Streak {
  userId        String    @id
  current       Int       @default(0)
  longest       Int       @default(0)
  lastActiveDay DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  kind     String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  name      String
  props     Json?
  ts        DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([userId])
  @@index([ts])
}

// A learner's edited playground code, saved per (user, topic, file) so it syncs
// across devices and survives navigation. Anonymous users fall back to localStorage.
model SavedCode {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  fileName  String
  source    String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, fileName])
  @@index([userId, topicId])
}

// Spaced-repetition schedule (SM-2). One row per (user, card). Card content is
// regenerated from content/ by cardKey ("p1a-001:fc:0") — only the schedule lives here.
model Review {
  id             String    @id @default(cuid())
  userId         String
  cardKey        String
  ease           Float     @default(2.5)
  intervalDays   Int       @default(0)
  reps           Int       @default(0)
  due            DateTime  @default(now())
  lastGrade      Int?
  lastReviewedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardKey])
  @@index([userId, due])
}
